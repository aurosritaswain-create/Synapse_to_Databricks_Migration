{
	"name": "SilverToGold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "SilverDataIn"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "SilvercsvIn"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "GoldDataOut"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "GoldcsvData"
				}
			],
			"transformations": [
				{
					"name": "SummarizeDailySales"
				},
				{
					"name": "aggregate2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as string,",
				"          retailer as string,",
				"          store_location as string,",
				"          department as string,",
				"          project_type as string,",
				"          sku as string,",
				"          brand as string,",
				"          unit_price as double,",
				"          quantity as integer,",
				"          {bulk_discount_applied_%} as integer,",
				"          subtotal_before_discount as double,",
				"          total_after_discount as double,",
				"          pro_program as string,",
				"          purchase_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'curated-data',",
				"     folderPath: 'silver_transactions') ~> SilverDataIn",
				"source(output(",
				"          transaction_id as string,",
				"          retailer as string,",
				"          store_location as string,",
				"          department as string,",
				"          project_type as string,",
				"          sku as string,",
				"          brand as string,",
				"          unit_price as double,",
				"          quantity as short,",
				"          {bulk_discount_applied_%} as short,",
				"          subtotal_before_discount as double,",
				"          total_after_discount as double,",
				"          pro_program as string,",
				"          purchase_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'curated-data',",
				"     folderPath: 'silver_csv_data') ~> SilvercsvIn",
				"SilverDataIn aggregate(groupBy(purchase_date),",
				"     total_daily_revenue = sum(total_after_discount)) ~> SummarizeDailySales",
				"SilvercsvIn aggregate(groupBy(department),",
				"     total_csv_revenue = sum(total_after_discount)) ~> aggregate2",
				"SummarizeDailySales sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold-data',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> GoldDataOut",
				"aggregate2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold-data',",
				"     folderPath: 'gold_csv_final',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> GoldcsvData"
			]
		}
	}
}